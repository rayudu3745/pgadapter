#eclipse-temurin:21-jdk
FROM us-docker.pkg.dev/artifact-foundry-prod/docker-3p-trusted/eclipse-temurin@sha256:3d92c3222b9d376e420e7099054604dc0d7bafbebbcb4f79ffd77763cd6a1bcd

# Create the working directory
WORKDIR /home/pgadapter

# Copy the pre-built application from the Cloud Build workspace
COPY target/pgadapter /home/pgadapter

# Copy other necessary files from the Cloud Build workspace
COPY LICENSE ./
COPY CONTRIBUTING.md ./
COPY README.md ./
COPY NOTIFICATIONS.md ./
COPY logging.properties ./

# Add and chmod startup script.
COPY build/startup.sh /home/pgadapter/startup.sh
RUN chmod +x /home/pgadapter/startup.sh

ENTRYPOINT ["/bin/bash", "/home/pgadapter/startup.sh"]